# Required only for `npm run discover` (the LLM discovery run).
# Replay never calls the API and needs no key.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for discovery. Replay is model-free.
DISCOVERY_MODEL=claude-opus-5

# Hard ceilings on the discovery loop (both double as spend caps).
DISCOVERY_MAX_STEPS=40
DISCOVERY_TIMEOUT_MS=600000
