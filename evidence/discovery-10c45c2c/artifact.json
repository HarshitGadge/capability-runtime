        "http://localhost:5173"
      ],
      "pathPrefixes": [
        "/t/"
      ],
      "actions": [
        "navigate",
        "click",
        "type",
        "press",
        "select",
        "extract",
        "assert"
      ],
      "maxUnattendedRisk": "elevated"
    }
  },
