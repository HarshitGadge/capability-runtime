{
  "schemaVersion": "1.0.0",
  "capability": {
    "id": "member.open_sub_account",
    "version": "1.0.0",
    "name": "Open a member sub-account",
    "description": "Looks up a member by numeric member ID, opens a new sub-account of the requested type with the given opening deposit, and returns the confirmation details. This commits a real, irreversible account opening and posts the opening deposit. Opening deposit must be at least $25.00.",
    "tags": [
      "discovered"
    ]
  },
  "target": {
    "appId": "acme-core/member-services",
    "appVersion": "7.2",
    "surface": "web",
    "entryPoint": "{baseUrl}/",
    "allowlist": {
      "origins": [
        "http://localhost:5173"
      ],
      "pathPrefixes": [
        "/t/"
      ],
      "actions": [
        "navigate",
        "click",
        "type",
        "press",
        "select",
        "extract",
        "assert"
      ],
      "maxUnattendedRisk": "elevated"
    }
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Numeric member identifier; exact match only, partial IDs are not supported.",
      "sensitivity": "regulated",
      "pattern": "^[0-9]+$",
      "example": "12345"
    },
    {
      "name": "account_type",
      "type": "string",
      "required": true,
      "description": "Sub-account product to open: Holiday Savings, Vacation Club, or Emergency Fund.",
      "sensitivity": "public",
      "example": "Holiday Savings"
    },
    {
      "name": "opening_deposit",
      "type": "currency",
      "required": true,
      "description": "Opening deposit amount in dollars, minimum 25.00.",
      "sensitivity": "regulated",
      "example": "250.00"
    }
  ],
  "outputs": [
    {
      "name": "confirmation_number",
      "type": "string",
      "description": "Confirmation number issued for the sub-account opening.",
      "sensitivity": "regulated",
      "required": true
    },
    {
      "name": "member",
      "type": "string",
      "description": "Member identifier and name shown on the confirmation.",
      "sensitivity": "regulated",
      "required": true
    },
    {
      "name": "account_type",
      "type": "string",
      "description": "Type of sub-account that was opened.",
      "sensitivity": "public",
      "required": true
    },
    {
      "name": "opening_deposit",
      "type": "currency",
      "description": "Opening deposit amount posted to the new sub-account.",
      "sensitivity": "regulated",
      "required": true
    }
  ],
