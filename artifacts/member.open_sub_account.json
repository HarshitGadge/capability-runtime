            "clearFirst": true
          },
          "target": {
            "semanticId": "signon.operator_id",
            "description": "Operator ID field on the sign-on screen",
            "strategies": [
              {
                "kind": "proximity_label",
                "role": "textbox",
                "label": "Operator ID",
