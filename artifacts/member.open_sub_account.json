{
  "schemaVersion": "1.0.0",
  "capability": {
    "id": "member.open_sub_account",
    "version": "1.0.0",
    "name": "Open member sub-account",
    "description": "Open a new savings sub-account for an existing member and return the confirmation number. The final step submits the account opening, which cannot be undone from within the application.",
    "tags": [
      "discovered"
    ]
  },
  "target": {
    "appId": "acme-core/member-services",
    "appVersion": "7.2",
    "surface": "web",
    "entryPoint": "{baseUrl}/",
    "allowlist": {
      "origins": [
        "http://localhost:5173"
      ],
      "pathPrefixes": [
        "/t/"
      ],
      "actions": [
        "navigate",
        "click",
        "type",
        "press",
        "select",
        "extract",
        "assert"
      ],
      "maxUnattendedRisk": "elevated"
    }
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "The member identifier to open the sub-account for.",
      "sensitivity": "internal",
      "pattern": "^\\d{4,10}$",
      "example": "12345"
    },
    {
      "name": "accountType",
      "type": "string",
      "required": true,
      "description": "Sub-account product type, exactly as listed in the product dropdown.",
      "sensitivity": "public",
      "example": "Holiday Savings"
    },
    {
      "name": "openingDeposit",
      "type": "string",
      "required": true,
      "description": "Opening deposit amount. The product enforces a $25.00 minimum.",
      "sensitivity": "internal",
      "example": "250.00"
    }
  ],
  "outputs": [
    {
      "name": "confirmation_number",
      "type": "string",
      "description": "Confirmation reference for the opened sub-account.",
      "sensitivity": "regulated",
      "required": true
    }
  ],
