{
  "schemaVersion": "1.0.0",
  "capability": {
    "id": "member.post_savings_transfer",
    "version": "1.0.0",
    "name": "Post a transfer from a member's savings account",
    "description": "Looks up a member by ID, opens their record, and posts a transfer of a given amount from their savings account to a specified destination account. Completes the review/confirm flow and returns the transfer reference and posted details. This posts real money movement immediately and cannot be reversed once confirmed.",
    "tags": [
      "discovered"
    ]
  },
  "target": {
    "appId": "acme-core/member-services",
    "appVersion": "7.2",
    "surface": "web",
    "entryPoint": "{baseUrl}/",
    "allowlist": {
      "origins": [
        "http://localhost:5173"
      ],
      "pathPrefixes": [
        "/t/"
      ],
      "actions": [
        "navigate",
        "click",
        "type",
        "press",
        "select",
        "extract",
        "assert"
      ],
      "maxUnattendedRisk": "elevated"
    }
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Numeric member identifier of the sending member",
      "sensitivity": "regulated",
      "pattern": "^[0-9]+$",
      "example": "12345"
    },
    {
      "name": "to_account",
      "type": "string",
      "required": true,
      "description": "Destination account number to receive the funds",
      "sensitivity": "regulated",
      "pattern": "^[0-9]+$",
      "example": "999888777"
    },
    {
      "name": "amount",
      "type": "currency",
      "required": true,
      "description": "Transfer amount in dollars, e.g. 50.00",
      "sensitivity": "regulated",
      "example": "50.00"
    }
  ],
  "outputs": [
    {
      "name": "reference",
      "type": "string",
      "description": "Transfer reference number issued on the confirmation screen",
      "sensitivity": "regulated",
      "required": true
    },
    {
      "name": "from_member",
      "type": "string",
      "description": "Sending member ID and name as shown on the confirmation",
      "sensitivity": "regulated",
      "required": true
    },
    {
      "name": "to_account",
      "type": "string",
      "description": "Destination account number as posted",
      "sensitivity": "regulated",
      "required": true
    },
    {
      "name": "amount",
      "type": "currency",
      "description": "Posted transfer amount",
      "sensitivity": "regulated",
      "required": true
    }
  ],
